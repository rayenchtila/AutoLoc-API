  },
  "item": [
    {
      "name": "Agences",
      "item": [
        {
          "name": "Lister les agences",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/agences", "host": ["{{baseUrl}}"], "path": ["api", "agences"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Consulter une agence inexistante",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/agences/9999", "host": ["{{baseUrl}}"], "path": ["api", "agences", "9999"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Statut 404\", () => pm.response.to.have.status(404));"
